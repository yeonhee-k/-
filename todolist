
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>MY TASKS</title>
<style>
:root{--blue:#3478f6;--blue-light:#eaf1ff;--green:#087b37;--ink:#161616;--muted:#777;--line:#e9e9e9;--bg:#fff;--red:#c94b4b}
*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans KR",sans-serif;font-size:14px}
.wrap{max-width:1440px;margin:0 auto;padding:30px 34px 24px}.header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding-bottom:22px;border-bottom:1px solid var(--line)}h1{font-size:clamp(30px,4vw,42px);letter-spacing:-1.5px;margin:0 0 8px;font-weight:800}.sub{font-size:12px;color:#777;letter-spacing:.04em}.badge{background:#e8f2ff;color:#2672cf;border-radius:20px;padding:5px 10px;font-size:12px;white-space:nowrap}
.stats{display:grid;grid-template-columns:repeat(3,1fr);padding:18px 0 20px;border-bottom:1px solid var(--line);gap:10px}.stat strong{display:block;font-size:23px;margin-bottom:5px}.stat:nth-child(2) strong{color:var(--blue)}.stat:nth-child(3) strong{color:var(--green)}.stat span{color:#777}
.main{display:grid;grid-template-columns:minmax(520px,1.65fr) minmax(310px,1fr);gap:34px;padding-top:22px}.calendar-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.month-title{font-size:19px;font-weight:750;letter-spacing:-.4px}.nav{display:flex;align-items:center;gap:5px}.nav button,.today{border:0;background:transparent;cursor:pointer;color:#555;font-size:17px;padding:5px 9px;border-radius:7px}.nav button:hover,.today:hover{background:#f2f2f2}.today{font-size:12px;border:1px solid var(--line);margin-left:4px}
.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.weekday{padding:10px 4px;color:#777;text-align:center;font-size:12px}.weekday:first-child{color:#c66}.weekday:last-child{color:#5b84cf}.day{min-height:clamp(82px,9vw,115px);border-top:1px solid var(--line);border-right:1px solid var(--line);padding:6px 5px;position:relative;cursor:pointer;transition:background .12s}.day:nth-child(7n){border-right:0}.day:hover{background:#fafcff}.day.other{color:#c2c2c2;background:#fcfcfc}.day.selected{background:#f5f8ff;box-shadow:inset 0 0 0 1px #d6e4ff}.day.today .num{color:var(--blue);font-weight:800}.day.selected .num{background:var(--blue);color:white;border-radius:50%;width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center}.num{font-size:12px;display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px}.ev{font-size:11px;line-height:1.35;padding:3px 5px;margin-top:3px;border-radius:4px;background:var(--blue-light);color:#2868d7;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ev.done{background:#edf6ef;color:#568765;text-decoration:line-through}.ev.time{font-weight:600}.more{font-size:10px;color:#888;padding:2px 4px}
.right{min-width:0}.list-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.list-head h2{font-size:15px;margin:0;font-weight:700}.list-head small{color:#777;font-size:12px}.list-section+.list-section{margin-top:26px}.task-list{border-top:1px solid var(--line)}.task{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:9px;padding:10px 1px;border-bottom:1px solid var(--line);align-items:start}.check{appearance:none;width:15px;height:15px;border:1px solid #aaa;border-radius:50%;margin:2px 0 0;cursor:pointer;position:relative}.check:checked{background:var(--green);border-color:var(--green)}.check:checked:after{content:'✓';color:white;position:absolute;font-size:10px;left:2px;top:0}.task-title{font-size:13px;line-height:1.5;cursor:pointer}.task-title.done{text-decoration:line-through;color:#888}.task-meta{font-size:11px;color:#777;margin-top:3px;line-height:1.5}.due{font-size:11px;color:#777;white-space:nowrap;padding-top:2px}.due.urgent{color:var(--red)}.due.today{color:var(--blue)}.task-actions{display:flex;gap:5px;opacity:.65}.task-actions button{border:0;background:none;color:#888;cursor:pointer;font-size:12px;padding:0 2px}.empty{color:#aaa;font-size:12px;padding:14px 0;border-bottom:1px solid var(--line)}.month-filter{border:1px solid var(--line);background:white;border-radius:6px;padding:5px 8px;font-size:12px;color:#555}
.addbar{display:flex;gap:9px;align-items:center;border-bottom:1px solid var(--line);padding:10px 0;margin:14px 0 5px}.addbar button{background:var(--blue);border:0;border-radius:6px;color:#fff;padding:8px 13px;cursor:pointer;font-size:12px}.addbar .hint{font-size:11px;color:#888}.form{display:none;padding:12px 0 15px;border-bottom:1px solid var(--line)}.form.open{display:block}.fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.fields .wide{grid-column:1/-1}input,textarea,select{font:inherit;border:1px solid #ddd;border-radius:6px;padding:8px 9px;width:100%;background:#fff;color:#222}textarea{resize:vertical;min-height:54px}.repeat-row{display:grid;grid-template-columns:110px 1fr;gap:8px;align-items:center}.repeat-extra{display:none}.repeat-extra.show{display:block}.form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}.form-actions button{border:1px solid #ddd;border-radius:6px;background:#fff;padding:7px 12px;cursor:pointer}.form-actions .save{background:var(--blue);color:white;border-color:var(--blue)}.form-actions .delete{margin-right:auto;color:var(--red)}.foot{font-size:11px;color:#aaa;padding-top:18px}
@media(max-width:900px){.wrap{padding:20px 18px}.main{grid-template-columns:1fr;gap:26px}.day{min-height:76px}.ev{font-size:10px}.right{display:grid;grid-template-columns:1fr 1fr;gap:22px}.list-section+.list-section{margin-top:0}}
@media(max-width:560px){.wrap{padding:16px 12px}.header{padding-bottom:16px}h1{font-size:30px}.stats{padding:14px 0}.stat strong{font-size:20px}.main{padding-top:16px;gap:22px}.calendar-head{margin-bottom:10px}.month-title{font-size:17px}.day{min-height:65px;padding:4px 2px}.num{width:21px;height:21px;font-size:11px}.ev{padding:2px 3px;font-size:9px}.right{display:block}.list-section+.list-section{margin-top:22px}.fields{grid-template-columns:1fr 1fr}.weekday{padding:8px 1px;font-size:11px}}
</style>
</head>
<body><div class="wrap">
<header class="header"><div><h1>MY TASKS</h1><div class="sub">MY PERSONAL PLANNER</div></div><span class="badge">MINIMAL</span></header>
<div class="stats"><div class="stat"><strong id="statTodo">00</strong><span>할 일</span></div><div class="stat"><strong id="statToday">00</strong><span>오늘 일정</span></div><div class="stat"><strong id="statDone">00</strong><span>완료</span></div></div>
<div class="main"><section class="cal-section"><div class="calendar-head"><div class="month-title" id="monthLabel"></div><div class="nav"><button id="prev">‹</button><button id="next">›</button><button class="today" id="goToday">오늘</button></div></div><div class="calendar" id="calendar"></div>
<div class="addbar"><button id="addBtn">＋ 일정 추가</button><span class="hint" id="selectedHint"></span></div>
<form class="form" id="taskForm"><input type="hidden" id="editId"><input type="hidden" id="editOccurrence">
<div class="fields"><input id="title" placeholder="할 일 / 일정 제목" required><input id="date" type="date" required><input id="start" type="time" placeholder="시작 시간"><input id="end" type="time" placeholder="종료 시간"><textarea class="wide" id="detail" placeholder="상세 내용 / 메모"></textarea><div class="repeat-row wide"><select id="repeat"><option value="none">반복 없음</option><option value="daily">매일</option><option value="monthly">매월</option></select><div class="repeat-extra" id="repeatExtra"><div id="monthlyExtra"><select id="monthDay"><option value="date">등록 날짜 기준</option><option value="1">매월 1일</option><option value="5">매월 5일</option><option value="10">매월 10일</option><option value="15">매월 15일</option><option value="20">매월 20일</option><option value="25">매월 25일</option><option value="last">매월 마지막 날</option></select></div><input id="repeatUntil" type="date" aria-label="반복 종료일"></div></div></div>
<div class="form-actions"><button type="button" class="delete" id="deleteBtn" style="display:none">삭제</button><button type="button" id="cancelBtn">취소</button><button class="save" type="submit">저장</button></div></form>
</section><aside class="right"><section class="list-section"><div class="list-head"><h2>TO DO</h2><small>날짜 가까운 순</small></div><div class="task-list" id="todoList"></div></section><section class="list-section"><div class="list-head"><h2>DONE</h2><select class="month-filter" id="doneMonth"></select></div><div class="task-list" id="doneList"></div></section></aside></div>
<div class="foot">일정은 이 브라우저에 자동 저장됩니다.</div></div>
<script>
const KEY='mytasks_planner_v1';let tasks=JSON.parse(localStorage.getItem(KEY)||'[]');let selected=new Date();selected.setDate(1);let clickedDate=new Date();let editTask=null;
const $=id=>document.getElementById(id);const pad=n=>String(n).padStart(2,'0');const keyDate=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;const dateFrom=s=>new Date(s+'T00:00:00');const monthKey=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}`;const save=()=>localStorage.setItem(KEY,JSON.stringify(tasks));
function occurrence(task,day){let date=keyDate(day);if(task.repeat==='daily'){if(date<task.date||task.until&&date>task.until)return false;return true}if(task.repeat==='monthly'){if(date<task.date||task.until&&date>task.until)return false;let target=task.monthDay==='last'?new Date(day.getFullYear(),day.getMonth()+1,0).getDate():task.monthDay==='date'?dateFrom(task.date).getDate():Number(task.monthDay);return day.getDate()===Math.min(target,new Date(day.getFullYear(),day.getMonth()+1,0).getDate())}return date===task.date}
function occId(t,d){return t.id+'@'+keyDate(d)}function allOccInMonth(m){let out=[];tasks.forEach(t=>{let start=new Date(m.getFullYear(),m.getMonth(),1),end=new Date(m.getFullYear(),m.getMonth()+1,0);for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1)){if(occurrence(t,d)){let k=keyDate(d),o=t.completed?.[k];out.push({task:t,date:new Date(d),key:k,completed:!!o,completedAt:o?.completedAt})}}});return out}
function render(){let y=selected.getFullYear(),m=selected.getMonth();$('monthLabel').textContent=`${y}년 ${m+1}월`;$('selectedHint').textContent=`선택한 날짜: ${keyDate(clickedDate)}`;let cal=$('calendar');cal.innerHTML='';['일','월','화','수','목','금','토'].forEach((w,i)=>{let el=document.createElement('div');el.className='weekday';el.textContent=w;cal.append(el)});
let first=new Date(y,m,1),start=new Date(y,m,1-first.getDay()),today=keyDate(new Date());for(let i=0;i<42;i++){let d=new Date(start);d.setDate(start.getDate()+i);let cell=document.createElement('div');cell.className='day'+(d.getMonth()!==m?' other':'')+(keyDate(d)===today?' today':'')+(keyDate(d)===keyDate(clickedDate)?' selected':'');cell.innerHTML=`<span class="num">${d.getDate()}</span>`;let events=allOccInMonth(selected).filter(o=>keyDate(o.date)===keyDate(d)).sort((a,b)=>(a.task.start||'').localeCompare(b.task.start||''));events.slice(0,3).forEach(o=>{let e=document.createElement('div');e.className='ev'+(o.completed?' done':'')+(o.task.start?' time':'');e.textContent=(o.task.start?o.task.start+' ':'')+o.task.title;e.title=o.task.title;cell.append(e)});if(events.length>3){let more=document.createElement('div');more.className='more';more.textContent=`+${events.length-3}개`;cell.append(more)}cell.onclick=()=>{clickedDate=d;render();openFormForDate(d)};cal.append(cell)}
let occ=allOccInMonth(selected);let todo=occ.filter(o=>!o.completed).sort((a,b)=>keyDate(a.date).localeCompare(keyDate(b.date))||(a.task.start||'').localeCompare(b.task.start||''));$('todoList').innerHTML='';todo.forEach(o=>addTaskRow($('todoList'),o,false));if(!todo.length)$('todoList').innerHTML='<div class="empty">예정된 할 일이 없습니다.</div>';
let done=occ.filter(o=>o.completed).sort((a,b)=>(b.completedAt||'').localeCompare(a.completedAt||''));$('doneList').innerHTML='';done.forEach(o=>addTaskRow($('doneList'),o,true));if(!done.length)$('doneList').innerHTML='<div class="empty">완료한 일이 없습니다.</div>';
let allUncompleted=tasks.reduce((n,t)=>n+Object.keys(t.completed||{}).filter(k=>!t.completed[k]).length,0);$('statTodo').textContent=String(todo.length).padStart(2,'0');$('statToday').textContent=String(allOccInMonth(new Date()).filter(o=>keyDate(o.date)===today).length).padStart(2,'0');$('statDone').textContent=String(done.length).padStart(2,'0');populateDoneMonths();}
function addTaskRow(container,o,isDone){let t=o.task,li=document.createElement('div');li.className='task';let cb=document.createElement('input');cb.type='checkbox';cb.className='check';cb.checked=isDone;cb.onchange=()=>{t.completed=t.completed||{};if(cb.checked)t.completed[o.key]={completedAt:new Date().toISOString()};else delete t.completed[o.key];save();render()};let content=document.createElement('div');let title=document.createElement('div');title.className='task-title'+(isDone?' done':'');title.textContent=t.title;title.onclick=()=>openEdit(t,o.key);let meta=document.createElement('div');meta.className='task-meta';meta.textContent=`${o.key}${t.start?' · '+t.start:''}${t.end?' ~ '+t.end:''}${t.repeat!=='none'?' · '+repeatLabel(t):''}${t.detail?' · '+t.detail:''}`;content.append(title,meta);let due=document.createElement('div');due.className='due';if(!isDone){let diff=Math.round((dateFrom(o.key)-dateFrom(keyDate(new Date())))/86400000);due.textContent=diff<0?`D+${Math.abs(diff)}`:diff===0?'D-Day':`D-${diff}`;if(diff<=1)due.classList.add('urgent');if(diff===0)due.classList.add('today')}else due.textContent='완료';li.append(cb,content,due);container.append(li)}
function repeatLabel(t){return t.repeat==='daily'?'매일':t.repeat==='monthly'?'매월':''}function populateDoneMonths(){let sel=$('doneMonth');let value=monthKey(selected);let base=new Date();base.setDate(1);let opts=[];for(let i=-24;i<=24;i++){let d=new Date(base.getFullYear(),base.getMonth()+i,1);opts.push(`<option value="${monthKey(d)}">${d.getFullYear()}년 ${d.getMonth()+1}월</option>`)}sel.innerHTML=opts.join('');sel.value=value;sel.onchange=()=>{let [y,m]=sel.value.split('-').map(Number);selected=new Date(y,m-1,1);clickedDate=new Date(y,m-1,1);render()}}
function openFormForDate(d){$('taskForm').classList.add('open');$('editId').value='';$('editOccurrence').value='';$('title').value='';$('date').value=keyDate(d);$('start').value='';$('end').value='';$('detail').value='';$('repeat').value='none';$('monthDay').value='date';$('repeatUntil').value='';$('deleteBtn').style.display='none';updateRepeat();$('title').focus()}
function openEdit(t,k){$('taskForm').classList.add('open');$('editId').value=t.id;$('editOccurrence').value=k;$('title').value=t.title;$('date').value=t.date;$('start').value=t.start||'';$('end').value=t.end||'';$('detail').value=t.detail||'';$('repeat').value=t.repeat||'none';$('monthDay').value=t.monthDay||'date';$('repeatUntil').value=t.until||'';$('deleteBtn').style.display='inline-block';updateRepeat()}
function updateRepeat(){let r=$('repeat').value;$('repeatExtra').classList.toggle('show',r!=='none');$('monthlyExtra').style.display=r==='monthly'?'block':'none'}$('repeat').onchange=updateRepeat;$('addBtn').onclick=()=>openFormForDate(clickedDate);$('cancelBtn').onclick=()=> $('taskForm').classList.remove('open');$('deleteBtn').onclick=()=>{let id=$('editId').value;if(id&&confirm('이 일정을 삭제할까요?')){tasks=tasks.filter(t=>t.id!==id);save();$('taskForm').classList.remove('open');render()}};
$('taskForm').onsubmit=e=>{e.preventDefault();let id=$('editId').value;let data={title:$('title').value.trim(),date:$('date').value,start:$('start').value,end:$('end').value,detail:$('detail').value.trim(),repeat:$('repeat').value,monthDay:$('monthDay').value,until:$('repeatUntil').value||null};if(!data.title)return;if(id){let t=tasks.find(t=>t.id===id);Object.assign(t,data)}else tasks.push({id:crypto.randomUUID(),...data,completed:{}});save();selected=dateFrom(data.date);clickedDate=dateFrom(data.date);$('taskForm').classList.remove('open');render()};$('prev').onclick=()=>{selected=new Date(selected.getFullYear(),selected.getMonth()-1,1);clickedDate=new Date(selected);render()};$('next').onclick=()=>{selected=new Date(selected.getFullYear(),selected.getMonth()+1,1);clickedDate=new Date(selected);render()};$('goToday').onclick=()=>{selected=new Date();selected.setDate(1);clickedDate=new Date();render()};render();
</script></body></html>
